# Copie para /opt/sortezeferius/backend/.env na Raspberry
# MongoDB local na Raspberry (usuário sortezeferiusdb). Se usar MongoDB Atlas, troque por:
# MONGO_URL="mongodb+srv://sortezeferiusdb:NVOoBxx3znYTvVMM@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGO_URL="mongodb://sortezeferiusdb:NVOoBxx3znYTvVMM@127.0.0.1:27017/sortezeferiusdb?authSource=sortezeferiusdb"
DB_NAME="sortezeferiusdb"
CORS_ORIGINS="*"
ADMIN_EMAIL="rithielegui@gmail.com"
ADMIN_PASSWORD="Rithi0518@"
JWT_SECRET="TROQUE-POR-UMA-CHAVE-ALEATORIA-LONGA"
# URL pública (usada nos webhooks Mercado Pago/InfinitePay e no retorno do checkout).
# Webhooks exigem HTTPS. Ex: https://sorte.zeferius.com.br  (ou http://sorte.zeferius.com.br:2525 sem webhooks)
PUBLIC_URL="https://sorte.zeferius.com.br"
MP_FEE_PERCENT="0.99"
